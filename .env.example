# BYOK AI provider credentials (store encrypted values in production)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Production public demo: required, cryptographically random 32-byte key,
# encoded as exactly 43 unpadded base64url characters. Never commit the value.
MAILAGENT_ENCRYPTION_KEY=
MODEL_CLASSIFICATION=claude-3-5-haiku-latest
MODEL_DRAFTING=claude-3-5-sonnet-latest
OPENROUTER_MODEL=google/gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-20b
MONTHLY_BUDGET_USD=0
MAX_REPLIES_PER_THREAD_PER_DAY=1

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Gmail OAuth (for Gmail accounts)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
DEMO_GMAIL_REDIRECT_URI=
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_BASE_URL=

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_AUTO_REPLIES_PER_HOUR=10
CONFIDENCE_THRESHOLD=0.85
DEFAULT_AUTONOMY_MODE=approve
DELAY_SEND_SECONDS=60

# Dashboard
# Personal mode: loopback only. Enterprise deployments that need network access
# must set an explicit IP and place the service behind an HTTPS reverse proxy.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
# Required for dashboard API access; never put these in frontend source.
DASHBOARD_API_TOKEN=
DASHBOARD_USER_ID=
# Comma-separated browser origins; leave empty to allow no cross-origin browser calls.
DASHBOARD_ALLOWED_ORIGINS=

# Public Demo Mode
# When enabled, serves a publicly accessible demo for hackathon judges.
# Zero-login for judges: retrieves and classifies genuine emails from dedicated Gmail.
PUBLIC_DEMO_MODE=false
DEMO_RATE_LIMIT_PER_MINUTE=30
DEMO_MAX_CONCURRENT_REQUESTS=5
DEMO_RESET_ENDPOINT_ENABLED=false
DEMO_SQLITE_DB_PATH=mailagent-demo.db
# Owner-authorized dedicated Gmail account for demo (retained across restarts)
DEMO_GMAIL_CLIENT_ID=
DEMO_GMAIL_CLIENT_SECRET=
DEMO_GMAIL_REDIRECT_URI=
DEMO_GMAIL_REFRESH_TOKEN=
DEMO_GMAIL_EMAIL=
DEMO_ALLOW_PUBLIC_SEND=false

# Storage Backend Configuration
# Personal default: sqlite. Set MAILAGENT_ENCRYPTION_KEY, or allow the OS
# keychain to create and retain one. Never commit either value.
# Options: sqlite (local file-based database, no cloud dependency)
#          supabase (enterprise/company-controlled PostgreSQL)
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=mailagent.db

# Task Queue Configuration
# Options: local (default, persistent APScheduler + SQLite job store)
#          celery (enterprise, requires Redis)
TASK_QUEUE_BACKEND=local
LOCAL_QUEUE_DB_PATH=mailagent-queue.db
